{
  "name": "landrace",
  "version": "0.0.0",
  "description": "Local-first SDLC orchestrator. Explicit workflow state machine, agent-agnostic.",
  "type": "module",
  "bin": {
    "landrace": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./hooks": "./dist/hooks.js",
    "./testing": "./dist/testing.js"
  },
  "imports": {
    "#tests/*.js": "./tests/*.ts",
    "#landrace/*.js": "./.landrace/*.ts",
    "#*.js": "./src/*.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "build": "tsup",
    "css": "node --experimental-strip-types scripts/build-css.mjs",
    "test": "jest && node --experimental-vm-modules ./node_modules/jest/bin/jest.js -c jest.esm.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests .landrace",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@ucast/mongo2js": "^2.0.0",
    "commander": "^13.1.0",
    "yaml": "^2.7.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.2",
    "eslint": "^9.25.0",
    "jest": "^29.7.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.3.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1"
  },
  "license": "MIT"
}
