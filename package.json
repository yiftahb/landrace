{
  "name": "landrace",
  "version": "0.0.0",
  "description": "Local-first SDLC orchestrator. Explicit workflow state machine, agent-agnostic.",
  "type": "module",
  "bin": {
    "landrace": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./hooks": "./dist/hooks.js",
    "./testing": "./dist/testing.js"
  },
  "files": [
    "dist",
    "workflows"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ucast/mongo2js": "^2.0.0",
    "commander": "^13.1.0",
    "yaml": "^2.7.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.2",
    "eslint": "^9.25.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1"
  },
  "license": "MIT"
}
