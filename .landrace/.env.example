# Copy to .landrace/.env and fill in. Never commit the real file.

# Optional: a personal access token, which overrides the board's Connect with GitHub.
# GITHUB_TOKEN=ghp_your_token_here

# Connect with GitHub's OAuth App, from its page (github.com → Settings →
# Developer settings → OAuth Apps), with the callback
# http://127.0.0.1:4546/connect/github/callback, matching serve.port. Both are
# required: a declared secret set nowhere refuses the start.
GITHUB_OAUTH_CLIENT_ID=Ov23li_your_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_client_secret

# Slack, for notify: an incoming webhook (Slack app → Incoming Webhooks), and
# your member id (profile → ⋮ → Copy member ID) so the post mentions you.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T…/B…/…
SLACK_NOTIFY_USER=U0123456789

# OpenTelemetry: export every event as a log record. Off unless this is 1;
# `landrace start --telemetry` sets it, and `--otel KEY=VALUE` overrides any
# of the rest. Defaults shown. The exporter is otlp or console; the protocol
# http/protobuf or http/json (grpc is refused); the interval is milliseconds.
# LANDRACE_ENABLE_TELEMETRY=1
# OTEL_LOGS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20your-token,x-team=infra
# OTEL_SERVICE_NAME=landrace
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
# OTEL_LOGS_EXPORT_INTERVAL=5000
